{
  "runes": {
    "crunes-plugins@kb:kb": {
      "vars": {
        "roots": [
          "docs/kb/crunes",
          "crunes-cli/docs/kb/crunes-cli",
          "crunes-plugins/docs/kb/crunes-plugins"
        ]
      },
      "run": {
        "permissions": {
          "allow": [
            "fs.glob:docs/kb/crunes/**/*.md",
            "fs.read:docs/kb/crunes/**",
            "fs.glob:crunes-cli/docs/kb/crunes-cli/**/*.md",
            "fs.read:crunes-cli/docs/kb/crunes-cli/**",
            "fs.glob:crunes-plugins/docs/kb/crunes-plugins/**/*.md",
            "fs.read:crunes-plugins/docs/kb/crunes-plugins/**"
          ]
        }
      }
    }
  },
  "plugins": {
    "crunes-plugins@kb": true
  }
}
