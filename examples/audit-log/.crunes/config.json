{
  "name": "audit-log",
  "runes": {
    "add": {
      "name": "Audit Log — Add",
      "description": "Appends a timestamped message to the project audit log.",
      "run": {
        "command": ".crunes/runes/add.rune.js",
        "permissions": {
          "allow": [
            "fs.write:./audit.log",
            "cache.read:@local-cache/**",
            "cache.write:@local-cache/**"
          ]
        }
      }
    },
    "export": {
      "name": "Audit Log — Export",
      "description": "Encodes the audit log as base64 and writes a chmod'd shell script.",
      "run": {
        "command": ".crunes/runes/export.rune.js",
        "permissions": {
          "allow": [
            "fs.read:./audit.log",
            "fs.write:./export/**"
          ]
        }
      }
    }
  }
}
