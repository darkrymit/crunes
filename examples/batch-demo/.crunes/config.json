{
  "name": "batch-demo",
  "runes": {
    "status": {
      "name": "Batch Demo — Status",
      "description": "Read-only project overview. Always safe to batch.",
      "batch": {
        "allow": [
          "*"
        ]
      },
      "run": {
        "command": ".crunes/runes/status/src/index.rune.js",
        "permissions": {
          "allow": [
            "fs.read:package.json"
          ]
        }
      }
    },
    "report": {
      "name": "Batch Demo — Report",
      "description": "Project report. 'read' subcommand is safe to batch; 'generate' writes a file and is not.",
      "batch": {
        "allow": [
          "read*"
        ],
        "deny": [
          "generate*"
        ]
      },
      "run": {
        "command": ".crunes/runes/report/src/index.rune.js",
        "permissions": {
          "allow": [
            "shell.run:git log *",
            "fs.write:./report.md"
          ]
        }
      }
    },
    "deploy": {
      "name": "Batch Demo — Deploy",
      "description": "Simulated deployment. No batch block — default deny-all applies.",
      "run": {
        "command": ".crunes/runes/deploy/src/index.rune.js",
        "permissions": {
          "allow": []
        }
      }
    }
  }
}
