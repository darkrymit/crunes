{
  "name": "cache-example",
  "runes": {
    "timestamp": {
      "name": "Timestamp Cache Demo",
      "description": "Caches first-run timestamp for 60s via @project-cache; reports age on subsequent runs",
      "permissions": {
        "use": {
          "allow": [
            "cache.read:@project-cache/**",
            "cache.write:@project-cache/**"
          ]
        }
      }
    },
    "project-info": {
      "name": "Project Info",
      "description": "Reads project metadata from @project/ import",
      "permissions": {
        "use": {
          "allow": ["fs.read:./project-meta.js"]
        }
      }
    }
  }
}
