{
  "name": "data-sync",
  "runes": {
    "sync": {
      "name": "Data Sync — Sync",
      "description": "Fetches remote posts, caches the fetch timestamp, and inserts new rows into SQLite.",
      "run": {
        "command": ".crunes/runes/sync.rune.js",
        "permissions": {
          "allow": [
            "http.fetch:GET::https://jsonplaceholder.typicode.com/**",
            "cache.read:@local-cache/**",
            "cache.write:@local-cache/**",
            "sqlite.read:@local-sqlite/**",
            "sqlite.write:@local-sqlite/**"
          ]
        }
      }
    },
    "report": {
      "name": "Data Sync — Report",
      "description": "Queries and displays the most recent stored posts.",
      "batch": {
        "allow": [
          "*"
        ]
      },
      "run": {
        "command": ".crunes/runes/report.rune.js",
        "permissions": {
          "allow": [
            "sqlite.read:@local-sqlite/**"
          ]
        }
      }
    }
  }
}
