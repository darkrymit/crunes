{
  "name": "file-vault",
  "runes": {
    "encrypt": {
      "name": "File Vault — Encrypt",
      "description": "Encrypts a file into the vault using AES-256-CBC.",
      "run": {
        "command": ".crunes/runes/encrypt.rune.js",
        "permissions": {
          "allow": [
            "fs.read:./**",
            "fs.write:./vault/**"
          ]
        }
      }
    },
    "list": {
      "name": "File Vault — List",
      "description": "Lists files currently stored in the vault.",
      "batch": {
        "allow": [
          "*"
        ]
      },
      "run": {
        "command": ".crunes/runes/list.rune.js",
        "permissions": {
          "allow": [
            "fs.read:./vault/**",
            "fs.glob:./vault::*.enc"
          ]
        }
      }
    },
    "decrypt": {
      "name": "File Vault — Decrypt",
      "description": "Decrypts a vault file back to the decrypted/ directory.",
      "run": {
        "command": ".crunes/runes/decrypt.rune.js",
        "permissions": {
          "allow": [
            "fs.read:./vault/**",
            "fs.write:./decrypted/**"
          ]
        }
      }
    }
  }
}
