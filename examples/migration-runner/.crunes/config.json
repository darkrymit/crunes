{
  "name": "migration-runner",
  "runes": {
    "migrate": {
      "name": "Migration Runner — Migrate",
      "description": "Runs pending SQL migrations and marks them as applied.",
      "run": {
        "command": ".crunes/runes/migrate.rune.js",
        "permissions": {
          "allow": [
            "fs.read:./migrations/**",
            "fs.glob:./migrations::*.sql",
            "sqlite.read:@local-sqlite/**",
            "sqlite.write:@local-sqlite/**",
            "cache.read:@local-cache/**",
            "cache.write:@local-cache/**"
          ]
        }
      }
    },
    "status": {
      "name": "Migration Runner — Status",
      "description": "Shows which migrations have been applied and which are pending.",
      "batch": {
        "allow": [
          "*"
        ]
      },
      "run": {
        "command": ".crunes/runes/status.rune.js",
        "permissions": {
          "allow": [
            "fs.glob:./migrations::*.sql",
            "cache.read:@local-cache/**"
          ]
        }
      }
    }
  }
}
