{
  "name": "streams-demo",
  "runes": {
    "generate": {
      "name": "Generate Large File",
      "run": {
        "command": ".crunes/runes/generate.rune.js",
        "permissions": {
          "allow": [
            "fs.read:large_data.bin",
            "fs.write:large_data.bin"
          ]
        }
      }
    },
    "decode": {
      "name": "Decode Large File",
      "run": {
        "command": ".crunes/runes/decode.rune.js",
        "permissions": {
          "allow": [
            "fs.read:large_data.bin",
            "fs.read:processed_data.txt",
            "fs.write:processed_data.txt"
          ]
        }
      }
    }
  }
}
