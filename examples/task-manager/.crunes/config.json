{
  "name": "task-manager",
  "runes": {
    "init": {
      "name": "Init",
      "description": "Create tasks.json if it does not exist.",
      "run": {
        "command": ".crunes/runes/init.rune.js",
        "permissions": {
          "allow": [
            "fs.read:./tasks.json",
            "fs.write:./tasks.json"
          ]
        }
      }
    },
    "task": {
      "name": "Task Manager",
      "description": "Per-project task tracker with nested tag management.",
      "run": {
        "command": ".crunes/runes/task.rune.js",
        "permissions": {
          "allow": [
            "fs.read:./tasks.json",
            "fs.write:./tasks.json"
          ]
        }
      }
    }
  }
}
